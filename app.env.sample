# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=screenly.example.com

SERVICE_USER=1000
SERVICE_GROUP=1000

APP_ORG_NAME=Anthias
APP_RUN_AS=1000:1000

CLOUDFLARE_ZONE_NAME=example.com
CLOUDFLARE_TUNNEL_ID=replace-with-your-tunnel-id
